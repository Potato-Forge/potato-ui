      "content": "export type PfDatePickerPrimitive = string | number | Date | null\nexport type PfDatePickerValue = PfDatePickerPrimitive | PfDatePickerPrimitive[]\nexport type PfDatePickerType = 'date' | 'time' | 'datetime'\n"
    },
