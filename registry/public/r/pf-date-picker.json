      "content": "export { default as PfDatePicker } from './PfDatePicker.vue'\nexport type {\n  PfDatePickerPrimitive,\n  PfDatePickerType,\n  PfDatePickerValue,\n} from './PfDatePicker.types'\n"
    }
  ]
