{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "pf-input",
  "type": "registry:component",
  "title": "PfInput",
  "description": "Native input wrapper with prefix/suffix slots, icons, clearable state, semantic tokens, sizes, and v-model support.",
  "dependencies": ["class-variance-authority", "clsx", "tailwind-merge"],
  "registryDependencies": ["pf-theme"],
  "meta": {
    "sourceEntry": "src/components/pf-input/PfInput.vue",
    "docsRoute": "/components/input"
  },
  "files": [
    {
      "path": "src/components/pf-input/PfInput.vue",
      "type": "registry:component",
      "target": "src/components/pf-input/PfInput.vue"
    },
    {
      "path": "src/components/pf-input/index.ts",
      "type": "registry:file",
      "target": "src/components/pf-input/index.ts"
    },
    {
      "path": "src/lib/utils.ts",
      "type": "registry:file",
      "target": "src/lib/utils.ts"
    }
  ]
}
