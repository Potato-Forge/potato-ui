{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "pf-icons",
  "type": "registry:style",
  "title": "Pf Icons",
  "description": "UnoCSS icon preset configuration for Tabler classes and the Potato Forge icon collection.",
  "dependencies": [],
