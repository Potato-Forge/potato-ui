#!/usr/bin/env python3
"""AI Memory Starter CLI."""

from __future__ import annotations

import argparse
import json
import shutil
from datetime import datetime, timezone
from pathlib import Path


STARTER_ROOT = Path(__file__).resolve().parent.parent
TEMPLATE_ROOT = STARTER_ROOT / "templates"
AI_TEMPLATE = TEMPLATE_ROOT / "ai"
ADAPTER_TEMPLATE = TEMPLATE_ROOT / "adapters"

ENTRY_MAP = {
    "codex": ("codex.md", "AGENTS.md"),
    "claude": ("claude.md", "CLAUDE.md"),
    "cursor": ("cursor.md", ".cursorrules"),
    "openclaw": ("openclaw.md", "AGENTS.openclaw.md"),
}


def slugify(value: str) -> str:
    result = []
    previous_dash = False
    for char in value.lower():
        if char.isalnum():
            result.append(char)
            previous_dash = False
        elif not previous_dash:
            result.append("-")
            previous_dash = True
    return "".join(result).strip("-") or "project"


def render(text: str, values: dict[str, str]) -> str:
    for key, value in values.items():
        text = text.replace("{{" + key + "}}", value)
    return text


def copy_template_dir(source: Path, target: Path, values: dict[str, str], force: bool) -> None:
    for source_file in source.rglob("*"):
        if source_file.is_dir():
            continue
        relative = source_file.relative_to(source)
        target_file = target / relative
        if target_file.exists() and not force:
            continue
        target_file.parent.mkdir(parents=True, exist_ok=True)
        target_file.write_text(render(source_file.read_text(), values))


def write_entry(agent: str, project_root: Path, values: dict[str, str], force: bool) -> bool:
    source_name, target_name = ENTRY_MAP[agent]
    source = ADAPTER_TEMPLATE / source_name
    target = project_root / target_name
    if target.exists() and not force:
        return False
    header = (
        "<!--\n"
        "  Generated by AI Memory Starter\n"
        f"  Source: templates/adapters/{source_name}\n"
        f"  Time: {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S UTC')}\n"
        "  Edit the adapter template or .ai/vendor/ when protocol changes.\n"
        "-->\n\n"
    )
    target.write_text(header + render(source.read_text(), values))
    return True


def write_project_script(project_root: Path, force: bool) -> None:
    script_dir = project_root / "scripts"
    script = script_dir / "ai-memory.py"
    if script.exists() and not force:
        return
    script_dir.mkdir(parents=True, exist_ok=True)
    script.write_text(PROJECT_SCRIPT)


def init_project(args: argparse.Namespace) -> None:
    project_root = Path(args.target).resolve()
    project_root.mkdir(parents=True, exist_ok=True)
    project_name = args.name or project_root.name
    values = {
        "PROJECT_NAME": project_name,
        "PROJECT_SLUG": slugify(project_name),
        "PROJECT_PATH": str(project_root),
    }

    copy_template_dir(AI_TEMPLATE, project_root / ".ai", values, args.force)
    adapter_target = project_root / "adapters"
    copy_template_dir(ADAPTER_TEMPLATE, adapter_target, values, args.force)
    write_project_script(project_root, args.force)

    synced = []
    for agent in args.agents:
        if agent == "hermes":
            continue
        if write_entry(agent, project_root, values, args.force):
            synced.append(agent)

    state = {
        "starter": "ai-memory-starter",
        "version": "0.1.0",
        "last_init": datetime.now(timezone.utc).isoformat(),
        "project_name": project_name,
        "synced_agents": synced,
    }
    (project_root / ".syncstate.json").write_text(json.dumps(state, indent=2) + "\n")

    print(f"Initialized .ai memory layer in {project_root}")
    if synced:
        print("Generated entries: " + ", ".join(synced))
    print("Next: fill .ai/core/*.md with project-specific facts.")


def main() -> None:
    parser = argparse.ArgumentParser(description="Install AI Memory Starter into a project")
    sub = parser.add_subparsers(dest="command", required=True)

    init = sub.add_parser("init", help="initialize .ai memory layer")
    init.add_argument("--target", default=".", help="target project directory")
    init.add_argument("--name", help="project display name")
    init.add_argument(
        "--agents",
        nargs="+",
        choices=list(ENTRY_MAP.keys()) + ["hermes"],
        default=["codex", "claude", "cursor", "openclaw"],
        help="agent entries to generate",
    )
    init.add_argument("--force", action="store_true", help="overwrite existing files")
    init.set_defaults(func=init_project)

    args = parser.parse_args()
    args.func(args)


PROJECT_SCRIPT = r'''#!/usr/bin/env python3
"""Project-local AI memory helper."""

from __future__ import annotations

import argparse
import hashlib
import json
from datetime import datetime, timezone
from pathlib import Path


PROJECT_ROOT = Path(__file__).resolve().parent.parent
AI_DIR = PROJECT_ROOT / ".ai"
ADAPTERS_DIR = PROJECT_ROOT / "adapters"
SYNCSTATE_FILE = PROJECT_ROOT / ".syncstate.json"

ENTRY_MAP = {
    "codex": ("codex.md", "AGENTS.md"),
    "claude": ("claude.md", "CLAUDE.md"),
    "cursor": ("cursor.md", ".cursorrules"),
    "openclaw": ("openclaw.md", "AGENTS.openclaw.md"),
}


def entry_hash() -> str:
    hasher = hashlib.sha256()
    for directory in [AI_DIR / "vendor", ADAPTERS_DIR]:
        if not directory.exists():
            continue
        for file in sorted(directory.glob("*.md")):
            hasher.update(file.read_bytes())
    return hasher.hexdigest()[:16]


def load_state() -> dict:
    if SYNCSTATE_FILE.exists():
        return json.loads(SYNCSTATE_FILE.read_text())
    return {}


def save_state(state: dict) -> None:
    SYNCSTATE_FILE.write_text(json.dumps(state, indent=2) + "\n")


def sync_agent(agent: str) -> bool:
    source_name, target_name = ENTRY_MAP[agent]
    source = ADAPTERS_DIR / source_name
    target = PROJECT_ROOT / target_name
    if not source.exists():
        print(f"missing adapter: {source}")
        return False
    header = (
        "<!--\n"
        "  Generated by scripts/ai-memory.py\n"
        f"  Source: adapters/{source_name}\n"
        f"  Time: {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S UTC')}\n"
        "  Edit adapter templates or .ai/vendor/ when protocol changes.\n"
        "-->\n\n"
    )
    target.write_text(header + source.read_text())
    print(f"synced {agent}: {target_name}")
    return True


def sync(args: argparse.Namespace) -> None:
    agents = args.agents or list(ENTRY_MAP)
    synced = []
    for agent in agents:
        if sync_agent(agent):
            synced.append(agent)
    state = load_state()
    previous = set(state.get("synced_agents", []))
    state["synced_agents"] = sorted(previous.union(synced))
    state["entry_hash"] = entry_hash()
    state["last_sync"] = datetime.now(timezone.utc).isoformat()
    save_state(state)


def status(_: argparse.Namespace) -> None:
    state = load_state()
    current = entry_hash()
    previous = state.get("entry_hash", "never")
    print("AI Memory status")
    print(f"entry hash: {current}")
    print(f"previous:   {previous}")
    print("changed:    " + ("yes" if current != previous else "no"))
    for agent, (source_name, target_name) in ENTRY_MAP.items():
        source = ADAPTERS_DIR / source_name
        target = PROJECT_ROOT / target_name
        if not source.exists():
            label = "missing adapter"
        elif not target.exists():
            label = "missing entry"
        elif source.stat().st_mtime > target.stat().st_mtime:
            label = "stale"
        else:
            label = "ok"
        print(f"{agent}: {label}")


def doctor(_: argparse.Namespace) -> None:
    required = [
        AI_DIR / "vendor" / "behavior.md",
        AI_DIR / "core" / "project.md",
        AI_DIR / "state" / "handoff.md",
        AI_DIR / "logs",
        ADAPTERS_DIR,
    ]
    failed = False
    for path in required:
        if not path.exists():
            failed = True
            print(f"missing: {path.relative_to(PROJECT_ROOT)}")
    if not failed:
        print("doctor: ok")


def main() -> None:
    parser = argparse.ArgumentParser(description="Project-local AI memory helper")
    sub = parser.add_subparsers(dest="command", required=True)

    sync_parser = sub.add_parser("sync", help="sync thin agent entries")
    sync_parser.add_argument("agents", nargs="*", choices=list(ENTRY_MAP))
    sync_parser.set_defaults(func=sync)

    status_parser = sub.add_parser("status", help="check entry sync status")
    status_parser.set_defaults(func=status)

    doctor_parser = sub.add_parser("doctor", help="check required .ai files")
    doctor_parser.set_defaults(func=doctor)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
'''


if __name__ == "__main__":
    main()
